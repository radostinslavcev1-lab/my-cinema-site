# ========================================================
# CINEMA STREAMING CATALOG - ENVIRONMENT CONFIGURATION
# ========================================================

# Flask Secret Key (Generate a random secure key for production)
SECRET_KEY=cinema-super-secret-key-change-in-production-2026

# Server Port
PORT=5000

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Streamtape API Credentials
# Get them from your Streamtape Dashboard: https://streamtape.com/panel/account
STREAMTAPE_LOGIN=your_streamtape_api_login_here
STREAMTAPE_KEY=your_streamtape_api_key_here

# Database Configuration
# Leave empty to use local SQLite (sqlite:///cinema.db)
# Or provide PostgreSQL URL for Render / Railway / Supabase:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Maximum Upload File Size in Megabytes (default: 5000MB = 5GB)
MAX_CONTENT_LENGTH_MB=5000
